# ════════════════════════════════════════════════════════════════════════════
#  Configuración de la aplicación
#  Copia este archivo a .env. Todas las variables son opcionales: sin ninguna,
#  la aplicación arranca con los valores por defecto.
# ════════════════════════════════════════════════════════════════════════════

# ── Puerto del backend HTTP local (default: 15050) ───────────────────────
# Si está ocupado, la app busca automáticamente el siguiente libre y
# guarda el elegido en .env.local.
# SERVER_PORT=15050

# ── Modo desarrollo ──────────────────────────────────────────────────────
# Con DEV_MODE activo, la ventana carga el dev server de Vite (recarga en
# caliente al editar el frontend) en lugar del bundle ya compilado que sirve
# el propio backend. Debe quedar en false para compilar el ejecutable.
# DEV_MODE=false
# DEV_URL=http://localhost:15173

# ── Branding (nombre, título de ventana, tooltip de bandeja) ─────────────
# APP_NAME=DesktopAppTemplate
# APP_TITLE=Desktop App Template
# TRAY_TOOLTIP=Desktop App Template
